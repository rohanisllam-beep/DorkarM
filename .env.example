# ==========================================
# Dorkar — Bhawal Mirzapur Bazar Environment Configuration
# ==========================================

# Server Port
PORT=3000

# ==========================================
# SMTP Email Notification Configuration
# ==========================================
# For Gmail, use smtp.gmail.com with port 587 (TLS) or 465 (SSL).
# Generate an App Password in your Google Account: Security -> 2-Step Verification -> App Passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Admin recipient email address to receive order notifications
ADMIN_EMAIL=your-admin-email@gmail.com

# Optional: Custom From sender header
SMTP_FROM="দরকারী — মির্জাপুর বাজার" <your-email@gmail.com>

# Optional / Backwards Compatibility
NOTIFICATION_EMAIL=your-admin-email@gmail.com

# AI Studio Gemini API Key (if needed for server-side AI features)
GEMINI_API_KEY=